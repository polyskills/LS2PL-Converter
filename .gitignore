__pycache__/
*.pyc
.venv/
.streamlit/secrets.toml

# Données clients (référentiels + historique de conversions) : sensibles,
# jamais versionnées. Sur un serveur dédié, ce dossier vit sur disque
# persistant en dehors du dépôt git.
data/clients/

# Réglages globaux modifiables depuis l'interface (ex. pied de page du menu
# latéral) : état d'exécution, pas du code — jamais versionné non plus.
data/app_config.json

# Déploiement Windows : binaire NSSM téléchargé à l'installation, et logs
# du service — jamais versionnés.
deploy/windows/tools/
logs/
